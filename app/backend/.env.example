# Copy to .env (git-ignored) to run the backend on PostgreSQL; without .env it uses in-memory H2.
# JDBC form of the Neon connection string of the dev branch, e.g.
# jdbc:postgresql://ep-....-pooler.c-13.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# ADR-0010. A secret of at least 32 characters; without it a restart logs everybody out
JWT_SECRET=
# Passwords of the demo accounts; an account whose password is empty is not created
DEMO_APPLICANT_PASSWORD=
DEMO_SECOND_APPLICANT_PASSWORD=
DEMO_RECRUITER_PASSWORD=
DEMO_ADMINISTRATOR_PASSWORD=
